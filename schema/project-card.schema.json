{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohereworks.github.io/schema/project-card.schema.json",
  "title": "COHERE project capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "summary", "kind", "status", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 320 },
    "kind": {
      "type": "string",
      "enum": ["research", "tool", "protocol", "workbench", "library", "infrastructure"]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["seed", "migrating", "active", "paused", "archived"] },
        "label": { "type": "string", "maxLength": 80 },
        "detail": { "type": "string", "maxLength": 240 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "alt"],
      "properties": {
        "kind": { "enum": ["ui-snapshot", "architecture-diagram", "result-visualization", "artifact"] },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 220 }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demo": { "$ref": "#/$defs/slot" },
        "spec": { "$ref": "#/$defs/slot" },
        "tests": { "$ref": "#/$defs/testSlot" }
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "kind": { "type": "string", "maxLength": 40 }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["url"] }
      ]
    },
    "testSlot": {
      "allOf": [
        { "$ref": "#/$defs/slot" },
        {
          "type": "object",
          "properties": {
            "command": { "type": "string", "maxLength": 240 }
          }
        }
      ]
    }
  }
}
